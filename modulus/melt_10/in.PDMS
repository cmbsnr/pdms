# LAMMPS输入文件示例：使用Martini 3粗粒化力场计算PDMS的均方回转半径
# -----------------------------------------------------
# 1. 初始化设置
# -----------------------------------------------------
units               real
dimension           3
boundary            p p p
atom_style          full

# 读取包含PDMS分子结构的data文件
read_data           bad_pdms_10_box.data

# -----------------------------------------------------
# 2. 力场参数设置（Martini 3参数）
# -----------------------------------------------------
# 定义非键相互作用（示例：Lennard-Jones势，截断距离可参考Martini 3常用取值）
pair_style lj/cut   12.0
special_bonds       lj 0.0 0.0 0.5
pair_coeff          1 1 0.7337 5.1
# 定义键、角、二面角势（示例参数，实际参数请参考相关文献）
bond_style          harmonic
bond_coeff          1 13.243 4.48
angle_style         harmonic
angle_coeff         1 5.48 86.0
dihedral_style      harmonic
dihedral_coeff      1 0.3346  1  1
# -----------------------------------------------------
# 3. 邻域列表设置
# -----------------------------------------------------
neigh_modify        one 1000
neighbor            1 bin
neigh_modify        delay 0 every 1 check yes

# -----------------------------------------------------
# 4. 能量最小化与预平衡
# -----------------------------------------------------
minimize            1.0e-4 1.0e-6 1000 10000
# npt系综下驰豫 
fix    1 all npt temp 300 300 50 iso 0 0 1000 drag 2
thermo_style  custom step temp press epair ebond eangle edihed pxx pyy pzz lx ly lz
thermo          1000
run    50000
#取消设置
unfix 1

# -----------------------------------------------------
# 5. npt下拉伸
# -----------------------------------------------------
# 计算应力
reset_timestep      0
compute             1 all stress/atom NULL
compute             2 all reduce sum c_1[1] c_1[2]
variable            CorVol equal ly*lx*lz
variable            sigmaxx equal c_2[1]/(v_CorVol*10000)
variable            px equal -pxx/10000
# 计算应变值
variable            tmp equal "lx"
variable            L0 equal ${tmp}
variable            strain equal "(lx - v_L0)/v_L0"
#dump输出
dump                1 all custom 10000 dump.pdms.lammpstrj id type x y z vx vy vz
#设置npt系综
fix                 1 all npt temp 300 300 50 y 0 0 1000 z 0 0 1000 drag 2
#deform拉伸，x方向
fix                 2 all deform 1 x erate 1e-7 units box remap x
#热力学输出
fix                 ave_sxx all ave/time 100 100 10000 v_px file stress_profile.dat ave one
thermo_style        custom step temp v_strain v_sigmaxx pxx pyy pzz lx ly lz epair ebond eangle edihed
thermo              1000

#启动模拟，20万步
run                 1000000
unfix               1
unfix               2