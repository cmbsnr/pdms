# -------------------- Save original box ---------------------
variable xlo equal xlo
variable xhi equal xhi
variable xlo_be equal ${xlo}
variable xlo_be equal -80.7373035031578
variable xhi_be equal ${xhi}
variable xhi_be equal 40.9802216721424
variable ylo equal ylo
variable yhi equal yhi
variable zlo equal zlo
variable zhi equal zhi

# -------------------- Expand box for Fe slabs ----------------
# Add 20 Å Fe slab on each side in x
change_box all x delta -10 10
Changing box ...
  orthogonal box = (-90.737304 -24.794527 -16.112105) to (50.980222 91.509617 99.412019)
variable xlo_af equal xlo
variable xhi_af equal xhi
print "${xlo_be} ${xhi_be}"
-80.7373035031578 40.9802216721424
print "${xlo_af} ${xhi_af}"
-90.7373035031578 50.9802216721424

# -------------------- Create Fe slabs ------------------------
lattice         bcc 2.855
Lattice spacing in x,y,z = 2.855 2.855 2.855

region Fe_left  block ${xlo_af} ${xlo_be} ${ylo} ${yhi} ${zlo} ${zhi} units box
region Fe_left  block -90.7373035031578 ${xlo_be} ${ylo} ${yhi} ${zlo} ${zhi} units box
region Fe_left  block -90.7373035031578 -80.7373035031578 ${ylo} ${yhi} ${zlo} ${zhi} units box
region Fe_left  block -90.7373035031578 -80.7373035031578 -24.7945265520728 ${yhi} ${zlo} ${zhi} units box
region Fe_left  block -90.7373035031578 -80.7373035031578 -24.7945265520728 91.5096167865088 ${zlo} ${zhi} units box
region Fe_left  block -90.7373035031578 -80.7373035031578 -24.7945265520728 91.5096167865088 -16.1121052287548 ${zhi} units box
region Fe_left  block -90.7373035031578 -80.7373035031578 -24.7945265520728 91.5096167865088 -16.1121052287548 99.4120190668551 units box
region Fe_right block ${xhi_be} ${xhi_af} ${ylo} ${yhi} ${zlo} ${zhi} units box
region Fe_right block 40.9802216721424 ${xhi_af} ${ylo} ${yhi} ${zlo} ${zhi} units box
region Fe_right block 40.9802216721424 50.9802216721424 ${ylo} ${yhi} ${zlo} ${zhi} units box
region Fe_right block 40.9802216721424 50.9802216721424 -24.7945265520728 ${yhi} ${zlo} ${zhi} units box
region Fe_right block 40.9802216721424 50.9802216721424 -24.7945265520728 91.5096167865088 ${zlo} ${zhi} units box
region Fe_right block 40.9802216721424 50.9802216721424 -24.7945265520728 91.5096167865088 -16.1121052287548 ${zhi} units box
region Fe_right block 40.9802216721424 50.9802216721424 -24.7945265520728 91.5096167865088 -16.1121052287548 99.4120190668551 units box

create_atoms    2 region Fe_left
Created 11644 atoms
  using lattice units in orthogonal box = (-90.737304 -24.794527 -16.112105) to (50.980222 91.509617 99.412019)
  create_atoms CPU = 0.002 seconds
create_atoms    2 region Fe_right
Created 11644 atoms
  using lattice units in orthogonal box = (-90.737304 -24.794527 -16.112105) to (50.980222 91.509617 99.412019)
  create_atoms CPU = 0.002 seconds

# -------------------- Groups --------------------------------
group Fe_left   region Fe_left
11644 atoms in group Fe_left
group Fe_right  region Fe_right
11644 atoms in group Fe_right
group Fe        union Fe_left Fe_right
23288 atoms in group Fe
group PDMS      subtract all Fe
12350 atoms in group PDMS

# -------------------- Masses --------------------------------
mass 1 72.0        # PDMS coarse-grained bead (example)
mass 2 55.845      # Fe

# ============================================================
#  Force field
# ============================================================

pair_style hybrid eam/alloy lj/cut 10.5

# Fe–Fe
pair_coeff * * eam/alloy FeNi.eam.alloy NULL Fe

# PDMS–PDMS (示例，用你自己换算到 metal 的 LJ)
pair_coeff 1 1 lj/cut 0.0318 5.1

# Fe–PDMS adhesion (弱 LJ，只传力)
pair_coeff 1 2 lj/cut 0.0159 5.1

# Bonded interactions (PDMS)
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic

bond_coeff      1 0.574 4.48
angle_coeff     1 0.238 86.0
dihedral_coeff  1 0.0145 1 1

# ============================================================
#  Initial relaxation (remove bad contacts)
# ============================================================

velocity        all create 300.0 12345 mom yes rot no

minimize        1.0e-6 1.0e-8 1000 10000

