Ave special neighs/atom = 5.76
Neighbor list builds = 8935
Dangerous builds = 0
#取消设置
unfix 1

# -----------------------------------------------------
# 5. npt下拉伸
# -----------------------------------------------------
# 计算应力
reset_timestep      0
compute             1 all stress/atom NULL
compute             2 all reduce sum c_1[1] c_1[2]
variable            CorVol equal ly*lx*lz
variable            sigmaxx equal c_2[1]/(v_CorVol*10000)
variable            px equal -pxx/10000
# 计算应变值
variable            tmp equal "lx"
variable            L0 equal ${tmp}
variable            L0 equal 115.981230950328
variable            strain equal "(lx - v_L0)/v_L0"
#dump输出
dump                1 all custom 10000 dump.pdms.lammpstrj id type x y z vx vy vz
#设置npt系综
fix                 1 all npt temp 100 100 50 y 0 0 1000 z 0 0 1000 drag 2
#deform拉伸，x方向
fix                 2 all deform 1 x erate 1e-7 units box remap x
#热力学输出
fix                 ave_sxx all ave/time 100 100 10000 v_px file stress_profile.dat ave one
thermo_style        custom step temp v_strain v_sigmaxx pxx pyy pzz lx ly lz epair ebond eangle edihed
thermo              1000

#启动模拟，20万步
run                 1000000
