variable            cer equal v_er/(1+v_er*v_runtime*(v_i-1))
fix                 1 all npt temp 300 300 50 y 0 0 2000 z 0 0 2000 drag 2
fix                 2 all deform 1 x erate ${cer} units box remap x
fix                 2 all deform 1 x erate 9.80392156862745e-08 units box remap x
# 启动模拟，n步
run                 ${runtime}
run                 100000
