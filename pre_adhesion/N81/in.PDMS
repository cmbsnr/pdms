# LAMMPS输入文件示例：使用Martini 3粗粒化力场计算PDMS的均方回转半径
# -----------------------------------------------------
# 1. 初始化设置
# -----------------------------------------------------
shell               mkdir ${file_name}
log                 ${file_name}/log.${file_name}
units               real
dimension           3
boundary            p p s
atom_style          full


# 读取包含PDMS分子结构的data文件
read_data           ${file_name}.data
change_box          all z delta 10.0 50.0 units box
# -----------------------------------------------------
# 2. 力场参数设置（Martini 3参数）
# -----------------------------------------------------
# 定义非键相互作用（示例：Lennard-Jones势，截断距离可参考Martini 3常用取值）
pair_style lj/cut   12.0
special_bonds       lj 0.0 0.0 0.5
pair_coeff          1 1 0.7337 5.1
# 定义键、角、二面角势（示例参数，实际参数请参考相关文献）
bond_style          harmonic
bond_coeff          1 13.243 4.48
angle_style         harmonic
angle_coeff         1 5.48 86.0
dihedral_style      harmonic
dihedral_coeff      1 0.3346  1  1
# -----------------------------------------------------
# 3. 邻域列表设置
# -----------------------------------------------------
neigh_modify    one 1000
neighbor        1 bin
neigh_modify    delay 0 every 1 check yes

# -----------------------------------------------------
# 4. 能量最小化与预平衡
# -----------------------------------------------------
velocity        all create 300 4928459
minimize        1.0e-4 1.0e-6 1000 10000
reset_timestep  0

group               bottom id <= 9600
fix                 spring_bottom bottom spring/self 1.0
# fix                 xwallslo all wall/reflect xlo EDGE
# fix                 ywallslo all wall/reflect ylo EDGE
# fix                 zwallslo all wall/reflect zlo EDGE
# fix                 xwallshi all wall/reflect xhi EDGE
# fix                 ywallshi all wall/reflect yhi EDGE
# fix                 zwallshi all wall/reflect zhi EDGE
compute             density all chunk/atom bin/1d z lower 5 units box
fix                 density_dist all ave/chunk 100 1000 100000 density density/mass file ${file_name}/${file_name}_density.txt

fix             1 all nvt temp 300.0 300.0 100.0
timestep        1
thermo_style    custom step temp press density vol lx ly lz
thermo          1000
dump            traj all custom 1000 ${file_name}/dump.${file_name}.lammpstrj id type x y z
run             500000
unfix           1



# 写出最终体系数据文件
write_data      ${file_name}/${file_name}_brush_out.data nocoeff