# -----------------------------------------------------
# 2. 力场参数设置（Martini 3参数）
# -----------------------------------------------------
# 定义非键相互作用（示例：Lennard-Jones势，截断距离可参考Martini 3常用取值）
pair_style lj/cut   12.0
pair_coeff          * * 0.7337 5.1
# 定义键、角、二面角势（示例参数，实际参数请参考相关文献）
bond_style          harmonic
bond_coeff          1 13.243 4.48
angle_style         harmonic
angle_coeff         1 5.48 86.0
dihedral_style      harmonic
dihedral_coeff      1 0.3346  1  1
# dihedral_style      class2
# dihedral_coeff      1 0.3346 1.14 0 0 0 0
# dihedral_coeff	    1 mbt   0 0 0 0
# dihedral_coeff	    1 ebt   0 0 0 0 0 0 0 0
# dihedral_coeff	    1 at    0 0 0 0 0 0 0 0
# dihedral_coeff	    1 aat   0 0 0
# dihedral_coeff	    1 bb13  0 0 0
# dihedral_style      charmm
# dihedral_coeff      1 0.3346 1 1 1
# -----------------------------------------------------
# 3. 邻域列表设置
# -----------------------------------------------------
neigh_modify    one 1000
neighbor        1 bin
neigh_modify    delay 0 every 1 check yes

# -----------------------------------------------------
# 4. 能量最小化与预平衡
# -----------------------------------------------------
minimize        1.0e-4 1.0e-6 1000 10000

