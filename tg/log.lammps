LAMMPS (29 Aug 2024)
# LAMMPS输入文件示例：使用Martini 3粗粒化力场计算PDMS的均方回转半径
# -----------------------------------------------------
# 1. 初始化设置
# -----------------------------------------------------
units               real
dimension           3
boundary            p p p
atom_style          full

# 读取包含PDMS分子结构的data文件
read_data           PDMS.data
Reading data file ...
  orthogonal box = (-62.5047 -62.5047 -62.5047) to (62.5047 62.5047 62.5047)
  2 by 2 by 4 MPI processor grid
  reading atoms ...
  14850 atoms
  reading velocities ...
  14850 velocities
