variable            name string ${input_name}
variable            aint equal 0.25
shell               mkdir ${name}
log                 ${name}/log.adhesion_adv
units               metal
dimension           3
boundary            p p f
atom_style          full

variable            dt equal 0.002
timestep            ${dt}

# 参数设置
variable            k equal "v_aint * 0.7337 / 23.06"  #定义压头与PDMS之间的LJ势的ε参数，单位为ev
variable            indent equal -0.25       #压痕速度，Å/ps
variable            minus_indent equal "v_indent * -1"

# 压入深度（埃）
variable            indent_depth equal 20.0
# 压头上方初始间距（埃）
variable            init_gap equal 20.0

# 定义键、角、二面角势
bond_style          harmonic
angle_style         harmonic
dihedral_style      harmonic
read_data           ${name}.data
pair_style          hybrid tersoff lj/cut 12.0
pair_coeff          * * tersoff SiC.tersoff NULL C
special_bonds       lj 0.0 0.0 0.5
pair_coeff          1 1 lj/cut 0.0318 5.1
pair_coeff          1 2 lj/cut ${k} 5.1
change_box          all z delta 0.0 50.0 units box

neighbor            0.2 bin
neigh_modify        delay 0 every 1 check yes

group               indenter type 2
group               substrate type 1
group               bottom id <= 9600
group               mobile subtract substrate bottom
compute             pdmsTemp substrate temp
compute             indenterTemp indenter temp
compute             pdmske substrate ke
compute             indenterke indenter ke
compute             fz indenter group/group substrate

# ---- 自动将压头放置在 PDMS 表面上方 20 Å ----
# surface_z = top 1% type-1 min z, 通过命令行 -var 传入
compute             indentZ indenter reduce min z
run                 0
variable            botZ equal c_indentZ
variable            gap equal ${surface_z}+${init_gap}-v_botZ
displace_atoms      indenter move 0 0 ${gap} units box
print               "PDMS surface (top5% type-1 min z) = ${surface_z}"
print               "Indenter bottom z = ${botZ}, gap = ${gap}"
uncompute           indentZ
write_data          ${name}/adhension_ini.data
# ---------------------------------------------------

fix                 spring_bottom bottom spring/self 1.0
fix                 zwallslo all wall/reflect zlo EDGE
fix                 zwallshi all wall/reflect zhi EDGE
dump                adv all custom 1000 ${name}/dump.adhesion_adv.lammpstrj id type x y z vx vy vz

# 步数由 run.sh 预计算后通过 -var 传入 (total_travel, nsteps_indent, nsteps_retract)

variable            depth equal 'step * v_indent * dt * (-1)'
variable            force equal "c_fz[3] * 1.602" # 将力转换为nN，1ev/A = 1.602nN
fix                 3 substrate nvt temp 300.0 300.0 0.1
fix                 4 indenter move linear 0.0 0.0 ${indent} units box
thermo_style        custom step atoms temp pe ke etotal density vol lx ly lz v_depth c_fz[1] c_fz[2] c_fz[3] c_pdmsTemp c_indenterTemp c_pdmske c_indenterke v_force
thermo              10
fix                 out all ave/time 10 100 1000 v_depth v_force file ${name}/force_10_100_1000.csv
print               "Indentation: ${nsteps_indent} steps, travel = ${total_travel} A"
run                 ${nsteps_indent}
variable            depth0 equal ${depth}
undump              adv
write_data          ${name}/adhension_middle.data
unfix               out

reset_timestep      0
compute             myChunk substrate chunk/atom bin/2d y lower 3 z lower 3 units box
fix                 fzmap1 substrate ave/chunk 1000 1 1000 myChunk fz norm none file ${name}/fz_map_1000_1_1000.txt
fix                 fzmap2 substrate ave/chunk 10 100 1000 myChunk fz norm none file ${name}/fz_map_10_100_1000.txt
dump                ret all custom 1000 ${name}/dump.adhesion_ret.lammpstrj id type x y z vx vy vz
variable            depth equal 'v_depth0 + step * v_minus_indent * dt * (-1)'
unfix               4
fix                 5 indenter move linear 0.0 0.0 ${minus_indent} units box
fix                 out all ave/time 10 100 1000 v_depth v_force append ${name}/force_10_100_1000.csv
print               "Retraction: ${nsteps_retract} steps"
run                 ${nsteps_retract}
write_data          ${name}/adhension_final.data
