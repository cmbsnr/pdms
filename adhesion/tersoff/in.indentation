units           metal
dimension       3
boundary        p p p
atom_style      full
log             log.indentation
# ---------- 金刚石晶格 ----------
lattice         diamond 3.567
region          whole block -40 40 -40 40 -40 80 units box
create_box      1 whole

# ---------- 定义几何参数 ----------
variable        R equal 25.0
variable        H equal 60.0

# ---------- 半球 ----------
# 球心在 (0,0,0)，取 z <= 0 部分
region          sphere_all sphere 0.0 0.0 0.0 ${R} units box
region          hemi block -100 100 -100 100 -${R} 0 units box
region          hemisphere intersect 2 sphere_all hemi

# ---------- 圆柱 ----------
region          cylinder_part cylinder z 0.0 0.0 ${R} 0 ${H} units box

# ---------- 合并区域 ----------
region          indenter union 2 hemisphere cylinder_part

# ---------- 填充原子 ----------
create_atoms    1 region indenter



pair_style      tersoff
pair_coeff      * * SiC.tersoff C
mass            1 12.011
write_data      indenter_ini.data
neighbor        0.1 bin
neigh_modify    every 1 delay 0 check yes
thermo          100
thermo_style    custom step atoms temp pe ke etotal density vol lx ly lz

dump            1 all atom 100 dump.indenter.lammpstrj
# minimize        1e-6 1e-8 1000 10000
# velocity        all create 300.0 4928459
fix             1 all npt temp 300.0 300.0 10.0 iso 1.0 1.0 1000.0
run             100000
write_data      indenter_final.data