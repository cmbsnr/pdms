units               metal
dimension           3
boundary            p p f
atom_style          full
log                 log.adhension
timestep            0.001

read_data           adhension.data
variable            k equal "1.0 * 0.7337 / 23.06"  #定义压头与PDMS之间的LJ势的ε参数，单位为ev
variable            indent equal -0.5       #压痕速度，A/ps
variable            minus_indent equal "v_indent * -1"
print               "${minus_indent}"
pair_style          hybrid tersoff lj/cut 12.0
pair_coeff          * * tersoff SiC.tersoff NULL C
special_bonds       lj 0.0 0.0 0.5
pair_coeff          1 1 lj/cut 0.0318 5.1
pair_coeff          1 2 lj/cut ${k} 5.1

# 定义键、角、二面角势
bond_style          harmonic
bond_coeff          1 0.5743 4.48
angle_style         harmonic
angle_coeff         1 0.23764 86.0
dihedral_style      harmonic
dihedral_coeff      1 0.01451 1 1


neighbor            0.2 bin
neigh_modify        delay 0 every 1 check yes

group               indenter type 2
group               substrate type 1
region              bottom block INF INF INF INF INF -40 units box
region              top block INF INF INF INF INF 200 units box
group               bottom region bottom
group               top region top
group               mobile subtract substrate bottom
compute             pdmsTemp substrate temp
compute             indenterTemp indenter temp
compute             pdmske substrate ke
compute             indenterke indenter ke
compute             f_ind indenter reduce sum fx fy fz

fix                 spring_bottom bottom spring/self 1.0
fix                 spring_top top spring/self 1.0

fix                 zwallslo all wall/reflect zlo EDGE
fix                 zwallshi all wall/reflect zhi EDGE
dump                min all custom 1000 dump.adhension.lammpstrj id type x y z vx vy vz
compute             fz indenter group/group substrate
fix                 2 indenter nvt temp 300.0 300.0 0.1
fix                 3 substrate nvt temp 300.0 300.0 0.1
thermo_style        custom step atoms temp pe ke etotal density vol lx ly lz # c_fz[1] c_fz[2] c_fz[3] c_pdmsTemp c_indenterTemp c_pdmske c_indenterke c_f_ind[1] c_f_ind[2] c_f_ind[3]
thermo              10
run                 2000000
write_data          adhension_eq.data

