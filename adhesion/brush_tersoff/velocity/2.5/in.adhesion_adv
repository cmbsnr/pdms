units               metal
dimension           3
boundary            p p f
atom_style          full
log                 log.adhesion_adv
timestep            0.001

# 参数设置
variable            k equal "1.0 * 0.7337 / 23.06"  #定义压头与PDMS之间的LJ势的ε参数，单位为ev
variable            indent equal -0.25       #压痕速度，A/ps
variable            minus_indent equal "v_indent * -1"

# 定义键、角、二面角势
bond_style          harmonic
angle_style         harmonic
dihedral_style      harmonic
read_data           adhension_eq.data
pair_style          hybrid tersoff lj/cut 12.0
pair_coeff          * * tersoff SiC.tersoff NULL C
special_bonds       lj 0.0 0.0 0.5
pair_coeff          1 1 lj/cut 0.0318 5.1
pair_coeff          1 2 lj/cut ${k} 5.1

neighbor            0.2 bin
neigh_modify        delay 0 every 1 check yes

group               indenter type 2
group               substrate type 1
group               bottom id <= 9600
group               mobile subtract substrate bottom
compute             pdmsTemp substrate temp
compute             indenterTemp indenter temp
compute             pdmske substrate ke
compute             indenterke indenter ke
compute             f_ind indenter reduce sum fx fy fz
compute             fz indenter group/group substrate

fix                 spring_bottom bottom spring/self 1.0
fix                 zwallslo all wall/reflect zlo EDGE
fix                 zwallshi all wall/reflect zhi EDGE
dump                adv all custom 1000 dump.adhesion_adv.lammpstrj id type x y z vx vy vz

variable            depth equal 'step * v_indent'
fix                 3 substrate nvt temp 300.0 300.0 0.1
fix                 4 indenter move linear 0.0 0.0 ${indent} units box
thermo_style        custom step atoms temp pe ke etotal density vol lx ly lz v_depth c_fz[1] c_fz[2] c_fz[3] c_pdmsTemp c_indenterTemp c_pdmske c_indenterke c_f_ind[1] c_f_ind[2] c_f_ind[3]
thermo              10
run                 340000
variable            depth0 equal ${depth}
undump              adv


reset_timestep      0
dump                ret all custom 1000 dump.adhesion_ret.lammpstrj id type x y z vx vy vz
variable            depth equal 'v_depth0 + step * v_minus_indent'
unfix               4
fix                 5 indenter move linear 0.0 0.0 ${minus_indent} units box
run                 300000
write_data          adhension_final.data