units               real
dimension           3
boundary            p p f
atom_style          full
log                 log.adhension

read_data           adhension.data
variable            k equal "1.0 * 0.7337"  #定义压头与PDMS之间的LJ势的ε参数，单位为kcal/mol
variable            indent equal -0.5       #压痕速度，A/ps

pair_style lj/cut   12.0
special_bonds       lj 0.0 0.0 0.5
pair_coeff          1 1 0.7337 5.1
pair_coeff          1 2 ${k} 5.1
pair_coeff          2 2 0.0 0.0

# 定义键、角、二面角势
bond_style          harmonic
bond_coeff          1 13.243 4.48
angle_style         harmonic
angle_coeff         1 5.48 86.0
dihedral_style      harmonic
dihedral_coeff      1 0.3346  1  1

neigh_modify        one 1000
neighbor            0.2 bin
neigh_modify        delay 0 every 1 check yes

group               indenter type 2
group               substrate type 1
region              bottom block INF INF INF INF INF 5 units box
group               bottom region bottom
group               mobile subtract substrate bottom
fix                 spring bottom spring/self 1.0

fix                 zwallslo all wall/reflect zlo EDGE
fix                 zwallshi all wall/reflect zhi EDGE
dump                min all custom 10000 dump.adhension.lammpstrj id type x y z vx vy vz
fix                 1 indenter rigid single
compute             fz indenter group/group substrate
fix                 2 all nvt temp 300.0 300.0 100.0
thermo_style        custom step atoms temp pe ke etotal density vol lx ly lz c_fz[1] c_fz[2] c_fz[3]
thermo              1000
run                 2000000
write_data          adhension_eq.data