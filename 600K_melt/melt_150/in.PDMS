# LAMMPS输入文件示例：使用Martini 3粗粒化力场计算PDMS的均方回转半径
# -----------------------------------------------------
# 1. 初始化设置
# -----------------------------------------------------
units               real
dimension           3
boundary            p p p
atom_style          full

# 读取包含PDMS分子结构的data文件
read_data           bad_pdms_150_box.data

# -----------------------------------------------------
# 2. 力场参数设置（Martini 3参数）
# -----------------------------------------------------
# 定义非键相互作用（示例：Lennard-Jones势，截断距离可参考Martini 3常用取值）
pair_style lj/cut   12.0
pair_coeff          1 1 0.7337 5.1
special_bonds       lj 0.0 0.0 0.5
# 定义键、角、二面角势（示例参数，实际参数请参考相关文献）
bond_style          harmonic
bond_coeff          1 13.243 4.48
angle_style         harmonic
angle_coeff         1 5.48 86.0
dihedral_style      harmonic
dihedral_coeff      1 0.3346  1  1
# -----------------------------------------------------
# 3. 邻域列表设置
# -----------------------------------------------------
neigh_modify    one 1000
neighbor        1 bin
neigh_modify    delay 0 every 1 check yes

# -----------------------------------------------------
# 4. 能量最小化与预平衡
# -----------------------------------------------------
minimize        1.0e-4 1.0e-6 1000 10000
fix             1 all npt temp 600.0 600.0 100.0 iso 1.0 1.0 1000
timestep        1
thermo_style    custom step temp press density vol
thermo          10000     
run             500000
unfix           1

# variable        lambda equal ramp(0.8,1.0)
# fix             2 all adapt 1 pair lj/cut/soft lambda * * v_lambda

# fix             3 all npt temp 600.0 600.0 100.0 iso 1.0 1.0 1000
# timestep        1
# thermo_style    custom step temp press density vol
# thermo          10000     
# run             50000
# unfix           3

# -----------------------------------------------------
# 5. 计算均方回转半径
# -----------------------------------------------------
# 使用compute gyration命令计算整个体系的回转半径
fix             equil all npt temp 600.0 600.0 100.0 iso 1.0 1.0 1000
group           pdms1 id <= 150
group           pdms2 id 151:300
group           pdms3 id 301:450
group           pdms4 id 451:600
group           pdms5 id 601:750
group           pdms6 id 751:900
group           pdms7 id 901:1050
group           pdms8 id 1051:1200
group           pdms9 id 1201:1350
group           pdms10 id 1351:1500
# variable        d_end equal "sqrt((x[1]-x[10])^2 + (y[1]-y[10])^2 + (z[1]-z[10])^2)"
compute         rg1 pdms1 gyration
compute         rg2 pdms2 gyration
compute         rg3 pdms3 gyration
compute         rg4 pdms4 gyration
compute         rg5 pdms5 gyration
compute         rg6 pdms6 gyration
compute         rg7 pdms7 gyration
compute         rg8 pdms8 gyration
compute         rg9 pdms9 gyration
compute         rg10 pdms10 gyration
# fix             avg pdms ave/time 1000 800 1000000 c_rg v_d_end file avg.txt
# 输出热力学信息及回转半径数据，每隔1000步输出一次
thermo_style    custom step temp pe ke etotal c_rg1 c_rg2 c_rg3 c_rg4 c_rg5 c_rg6 c_rg7 c_rg8 c_rg9 c_rg10 press density vol
# fix             avg pdms ave/time 1000 800 1000000 c_rg v_d_end file avg.txt
# 输出热力学信息及回转半径数据，每隔1000步输出一次
thermo          10000
# 输出轨迹文件，便于后续可视化与分析
dump            traj all custom 1000 dump.pdms.lammpstrj id type x y z
# 运行模拟，记录回转半径数据（后续可统计分析均值与波动）
run             1000000
unfix           equil
# -----------------------------------------------------
# 6. 数据输出
# -----------------------------------------------------


# # 写出最终体系数据文件
# write_data      pdms_out.data