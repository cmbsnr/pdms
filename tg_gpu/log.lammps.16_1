LAMMPS (29 Aug 2024)
package gpu 1
# LAMMPS输入文件示例：使用Martini 3粗粒化力场计算PDMS的均方回转半径
# -----------------------------------------------------
# 1. 初始化设置
# -----------------------------------------------------
units               real
dimension           3
boundary            p p p
atom_style          full

# 读取包含PDMS分子结构的data文件
read_data           PDMS.data
Reading data file ...
  orthogonal box = (-62.5047 -62.5047 -62.5047) to (62.5047 62.5047 62.5047)
  2 by 2 by 4 MPI processor grid
  reading atoms ...
  14850 atoms
  reading velocities ...
  14850 velocities
  scanning bonds ...
  1 = max bonds/atom
  scanning angles ...
  1 = max angles/atom
  scanning dihedrals ...
  1 = max dihedrals/atom
  orthogonal box = (-62.5047 -62.5047 -62.5047) to (62.5047 62.5047 62.5047)
  2 by 2 by 4 MPI processor grid
  reading bonds ...
  14553 bonds
  reading angles ...
  14256 angles
  reading dihedrals ...
  13959 dihedrals
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     2 = max # of 1-2 neighbors
     2 = max # of 1-3 neighbors
     4 = max # of 1-4 neighbors
     6 = max # of special neighbors
  special bonds CPU = 0.002 seconds
  read_data CPU = 0.108 seconds

# -----------------------------------------------------
# 2. 力场参数设置（Martini 3参数）
# -----------------------------------------------------
# 定义非键相互作用（示例：Lennard-Jones势，截断距离可参考Martini 3常用取值）
pair_style 	    lj/cut/gpu 12.0
pair_coeff          * * 0.7337 5.1
# 定义键、角、二面角势（示例参数，实际参数请参考相关文献）
bond_style          harmonic
bond_coeff          1 13.243 4.48
angle_style         harmonic
angle_coeff         1 5.48 86.0
dihedral_style      harmonic
dihedral_coeff      1 0.3346  1  1
# -----------------------------------------------------
# 3. 邻域列表设置
# -----------------------------------------------------
neigh_modify    one 2000
neighbor        1 bin
neigh_modify    delay 0 every 1 check yes

# -----------------------------------------------------
# 4. 能量最小化与预平衡
# -----------------------------------------------------
minimize        1.0e-4 1.0e-6 1000 10000

