LAMMPS (29 Aug 2024)
# LAMMPS输入文件示例：使用Martini 3粗粒化力场计算PDMS的均方回转半径
# -----------------------------------------------------
# 1. 初始化设置
# -----------------------------------------------------
units               real
dimension           3
boundary            p p f
atom_style          full

# 读取包含PDMS分子结构的data文件
read_data           martini_water_box.data
Reading data file ...
  orthogonal box = (-1 -1 -1) to (135 135 135)
  2 by 2 by 4 MPI processor grid
  reading atoms ...
  18928 atoms
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     0 = max # of 1-2 neighbors
     0 = max # of 1-3 neighbors
     0 = max # of 1-4 neighbors
     1 = max # of special neighbors
  special bonds CPU = 0.001 seconds
  read_data CPU = 0.018 seconds
change_box          all x delta -20 20
Changing box ...
  orthogonal box = (-21 -1 -1) to (155 135 135)
change_box          all y delta -20 20
Changing box ...
  orthogonal box = (-21 -21 -1) to (155 155 135)
change_box          all z delta -20 20
Changing box ...
  orthogonal box = (-21 -21 -21) to (155 155 155)
# fix                 xwallslo all wall/reflect xlo EDGE xhi EDGE
# fix                 ywallslo all wall/reflect ylo EDGE yhi EDGE
fix                 zwallslo all wall/reflect zlo EDGE zhi EDGE
# -----------------------------------------------------
# 2. 力场参数设置（Martini 3参数）
# -----------------------------------------------------
# 定义非键相互作用（示例：Lennard-Jones势，截断距离可参考Martini 3常用取值）
pair_style          lj/cut   12.0
pair_coeff          1 1 1.1071 4.7
# pair_coeff          1 2 0.8929 4.4
# pair_coeff          1 3 0.8095 4.1
# pair_coeff          2 2 0.7619 4.1
# pair_coeff          2 3 0.7024 3.8
# pair_coeff          3 3 0.6667 3.5
# # 定义键、角、二面角势（示例参数，实际参数请参考相关文献）
# bond_style          harmonic
# bond_coeff          1 13.243 4.48
# angle_style         harmonic
# angle_coeff         1 5.48 86.0
# dihedral_style      harmonic
# dihedral_coeff      1 0.3346  1  1
# -----------------------------------------------------
# 3. 邻域列表设置
# -----------------------------------------------------
neigh_modify    one 2000
neighbor        1 bin
neigh_modify    delay 0 every 1 check yes

# -----------------------------------------------------
# 4. 能量最小化与预平衡
# -----------------------------------------------------
minimize        1.0e-4 1.0e-6 1000 10000

