# LAMMPS输入文件示例：使用Martini 3粗粒化力场计算PDMS的均方回转半径
# -----------------------------------------------------
# 1. 初始化设置
# -----------------------------------------------------
units               real
dimension           3
boundary            p p f
atom_style          full

# 读取包含PDMS分子结构的data文件
read_data           martini_water_box.data
change_box          all x delta -20 20
change_box          all y delta -20 20
change_box          all z delta -20 20
# fix                 xwallslo all wall/reflect xlo EDGE xhi EDGE
# fix                 ywallslo all wall/reflect ylo EDGE yhi EDGE
fix                 zwallslo all wall/reflect zlo EDGE zhi EDGE
# -----------------------------------------------------
# 2. 力场参数设置（Martini 3参数）
# -----------------------------------------------------
# 定义非键相互作用（示例：Lennard-Jones势，截断距离可参考Martini 3常用取值）
pair_style          lj/cut   12.0
pair_coeff          1 1 1.1071 4.7
# pair_coeff          1 2 0.8929 4.4
# pair_coeff          1 3 0.8095 4.1
# pair_coeff          2 2 0.7619 4.1
# pair_coeff          2 3 0.7024 3.8
# pair_coeff          3 3 0.6667 3.5
# # 定义键、角、二面角势（示例参数，实际参数请参考相关文献）
# bond_style          harmonic
# bond_coeff          1 13.243 4.48
# angle_style         harmonic
# angle_coeff         1 5.48 86.0
# dihedral_style      harmonic
# dihedral_coeff      1 0.3346  1  1
# -----------------------------------------------------
# 3. 邻域列表设置
# -----------------------------------------------------
neigh_modify    one 2000
neighbor        1 bin
neigh_modify    delay 0 every 1 check yes

# -----------------------------------------------------
# 4. 能量最小化与预平衡
# -----------------------------------------------------
minimize        1.0e-4 1.0e-6 1000 10000
fix             1 all nvt temp 300.0 300.0 100.0
dump            traj all custom 1000 dump.water.lammpstrj id type x y z
timestep        1
thermo_style    custom step temp press density vol
thermo          10000     
run             100000
unfix           1
# fix             2 all nvt temp 300.0 300.0 100.0
# dump            traj all custom 1000 dump.water.lammpstrj id type x y z
# compute         msd_all all msd
# fix             msdout all ave/time 100 10 1000 c_msd_all[*] file msd_water.txt
# run             5000000
# unfix           2
write_data      water_out.data