# 恒速拖曳法(替代恒力法): 活动谐振陷阱拖动水珠质心, 测量稳态摩擦力-速度曲线
# ------------------------------------------------------------------
# 原理:
#   对水珠每个原子施加 均匀力  f_i = -k*(xcm - x_ref),  x_ref = x0 + v_drag*(step-N_equi)
#   (均匀力 = 体体力, 同恒力驱动, 不改变水珠内部结构/温度分布)
#   总力 = Nw*k*(x_ref - xcm): 水珠质心被"陷阱"以 v_drag 匀速牵引。
#   稳态时 质心速度 ≈ v_drag, 且 牵引力 = 刷层摩擦力。
#   测量稳态牵引力 即得 该拖曳速度下的摩擦力。扫 v_drag 得 摩擦-速度曲线。
#
# 优点 vs 恒力法:
#   - 质心速度被钳制, 不会加速失控/高速过热(恒力法在速度弱化摩擦下无法达终端速度)
#   - 温度可控 (两相都加Langevin), 摩擦测量更干净
#
# 用法:
#   lmp_mpi -var name <前缀> -var vd <拖曳速度 A/fs> -in in.trap
#   建议 vd: 1e-5, 1e-4, 1e-3 (=1, 10, 100 m/s), 覆盖从粘滞到滑移
#   输出: 牵引力 v_fspring_total 的稳态平均 = 摩擦力, 对应速度 vd
variable        file_name string ${name}
variable        vd      index 1.0e-3        # 拖曳速度 (A/fs), 可用 -var vd 覆盖
shell           mkdir ${file_name}
log             ${file_name}/${file_name}_trap_vd${vd}.log

units           real
dimension       3
boundary        p p f
atom_style      full

pair_style      lj/cut   12.0
special_bonds   lj 0.0 0.0 0.5
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic

read_data       ${file_name}/${file_name}_water_eq.data

pair_coeff      1 1 0.7337 5.1
pair_coeff      1 2 0.5762 4.65
pair_coeff      2 2 1.1071 4.7
bond_coeff      1 13.243 4.48
angle_coeff     1 5.48 86.0
dihedral_coeff  1 0.3346 1 1

change_box      all z delta 0.0 40.0 units box

neighbor        1 bin
neigh_modify    delay 0 every 1 check yes

group           water type 2
group           pdms  type 1
group           bottom id <= 9600

velocity        all create 300 4928459
velocity        water zero linear

# ------------------------------------------------------------------
# 积分与控温 (同 in.friction)
# ------------------------------------------------------------------
compute         tcomw water temp/com
fix             integrate all nve
fix             therm_water water langevin 300.0 300.0 100.0 12345 zero yes
fix_modify      therm_water temp tcomw
fix             therm_pdms  pdms  langevin 300.0 300.0 100.0 6789
fix             spring_bottom bottom spring/self 1.0
fix             wall_zlo all wall/reflect zlo EDGE
fix             wall_zhi all wall/reflect zhi EDGE

# ------------------------------------------------------------------
# 测量量
#   v_vxw                 = 水珠质心速度x (应≈vd)
#   v_xcmw/v_ycmw/v_zcmw  = 水珠质心
#   v_fspring_total       = 陷阱对水珠的总牵引力(+x = 向+x拖)
#   c_fwat_x              = 水珠x方向总受力 (含陷阱+摩擦+langevin)
#   v_fric_x              = c_fwat_x - 陷阱力 = 刷层摩擦力
#   * 稳态时 c_fwat_x ≈ 0, 牵引力 ≈ -摩擦力; force文件后段 v_fspring_total 平均 = 摩擦力
# ------------------------------------------------------------------
variable        Nw     equal count(water)
compute         pav    water property/atom vx vy vz
compute         vxsum  water reduce sum c_pav[1]
variable        vxw    equal c_vxsum/v_Nw
variable        xcmw   equal xcm(water,x)
variable        ycmw   equal xcm(water,y)
variable        zcmw   equal xcm(water,z)
compute         patom  water property/atom fx fy fz
compute         fwat_x water reduce sum c_patom[1]

variable        N_equi  equal 20000
variable        N_drag  equal 200000

# 预平衡(无陷阱) 20ps, 使界面松弛
run             ${N_equi}

# ------------------------------------------------------------------
# 活动陷阱 (关键参数), 在预平衡后创建
#   ktrap  每原子陷阱刚度 [kcal/mol/A^2]; 总刚度 = Nw*ktrap ~ 9.2
#   x0     陷阱起始x = 预平衡结束时的水珠质心 (print->include 冻结为常量)
#   x_ref  = x0 + vd*(step - N_equi)   (陷阱自预平衡结束位置匀速移动)
#   f_i    = -ktrap*(xcm - x_ref)  -> 每原子均匀力, 总牵引力 = Nw*ktrap*(x_ref-xcm)
#   稳态: 总牵引力 = 摩擦力, 质心速度 = vd
# ------------------------------------------------------------------
variable        ktrap  equal 1.0e-2        # 每原子刚度; 总刚度~91, 响应~530fs, 稳态滞后~1A
print           "variable x0 string ${xcmw}" file ${file_name}/x0.txt
include         ${file_name}/x0.txt
variable        xref   equal v_vd*(step-${N_equi})+v_x0
variable        ftr    equal -v_ktrap*(xcm(water,x)-v_xref)
variable        fspring_total equal v_Nw*v_ktrap*(v_xref-xcm(water,x))
variable        fric_x equal c_fwat_x-v_fspring_total

fix             trap_water water addforce v_ftr 0.0 0.0

fix             out_vel water ave/time 100 10 1000 v_vxw v_xcmw v_ycmw v_zcmw v_fspring_total file ${file_name}/${file_name}_trap_vd${vd}_vel.txt
fix             out_frc water ave/time 100 10 1000 c_fwat_x v_fric_x v_fspring_total c_tcomw file ${file_name}/${file_name}_trap_vd${vd}_force.txt

thermo_style    custom step temp c_tcomw v_vxw v_xcmw v_fspring_total c_fwat_x v_fric_x
thermo          5000
dump            traj all custom 5000 ${file_name}/dump.${file_name}_trap_vd${vd}.lammpstrj id type x y z
timestep        1

run             ${N_drag}

variable        fss equal v_fspring_total
print           "TRAP_END  vd=${vd}  vxw=${vxw}  xcmw=${xcmw}  fspring_total=${fss}  fric_x=${fric_x}  (取force文件后段平均 = 该速度下摩擦力)"
write_data      ${file_name}/${file_name}_trap_vd${vd}_end.data
