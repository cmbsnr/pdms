# LAMMPS输入文件 - PDMS刷层+水球（自适应盒子尺寸）
# -----------------------------------------------------
# 1. 初始化设置
# -----------------------------------------------------
variable            file_name string ${name}
shell               mkdir ${file_name}
log                 ${file_name}/log.${file_name}
units               real
dimension           3
boundary            p p f
atom_style          full

read_data           ${file_name}.data extra/atom/types 1

# 冻结原始盒子参数（$()即时求值，之后change_box不影响）
variable            Lx        equal $(xhi-xlo)
variable            Ly        equal $(yhi-ylo)
variable            brush_zhi equal $(zhi)

# -----------------------------------------------------
# 2. 力场参数（Martini 3: 1=PDMS, 2=水珠W）
# -----------------------------------------------------
pair_style          lj/cut   12.0
special_bonds       lj 0.0 0.0 0.5

pair_coeff          1 1 0.7337 5.1
pair_coeff          1 2 0.5762 4.65
pair_coeff          2 2 1.1071 4.7

mass                2 72.0

bond_style          harmonic
bond_coeff          1 13.243 4.48
angle_style         harmonic
angle_coeff         1 5.48 86.0
dihedral_style      harmonic
dihedral_coeff      1 0.3346  1  1

# -----------------------------------------------------
# 3. 邻域列表设置
# -----------------------------------------------------
neigh_modify        one 1000
neighbor            1 bin
neigh_modify        delay 0 every 1 check yes

# -----------------------------------------------------
# 4. 水球创建（尺寸自动从盒子计算）
# -----------------------------------------------------
# 水球: 直径=Ly, 下沿=刷顶+5Å
# drop_r = Ly/2, drop_z = brush_zhi + 5 + drop_r
# delta_hi = 2*drop_r + 15 (确保球顶+余量)

variable            drop_r    equal v_Ly/2
variable            drop_x    equal v_Lx/2
variable            drop_y    equal v_Ly/2
variable            drop_z    equal v_brush_zhi+5.0+v_drop_r
variable            delta_hi  equal $((yhi-ylo)+15)

change_box          all z delta -10.0 ${delta_hi} units box

# z方向上下反射墙（防越界/防周期性缠绕）
fix                 wall_zlo all wall/reflect zlo EDGE
fix                 wall_zhi all wall/reflect zhi EDGE

region              water_sphere sphere v_drop_x v_drop_y v_drop_z v_drop_r units box

lattice             fcc 7.83
create_atoms        2 region water_sphere units box

# -----------------------------------------------------
# 5. 能量最小化与预平衡
# -----------------------------------------------------
velocity            all create 300 4928459
minimize            1.0e-4 1.0e-6 1000 10000
reset_timestep      0

group               bottom id <= 9600
fix                 spring_bottom bottom spring/self 1.0

compute             density all chunk/atom bin/1d z lower 5 units box
fix                 density_dist all ave/chunk 100 1000 100000 density density/mass file ${file_name}/${file_name}_density.txt

# 分温度输出: 总温度 / 水(type 2) / PDMS(type 1)
group               water type 2
group               pdms type 1
compute             water_temp water temp
compute             pdms_temp pdms temp

fix                 1 all nvt temp 300.0 300.0 100.0
timestep            1
thermo_style        custom step temp c_water_temp c_pdms_temp press density vol lx ly lz
thermo              1000
dump                traj all custom 1000 ${file_name}/dump.${file_name}.lammpstrj id type x y z
run                 500000
unfix               1

write_data          ${file_name}/${file_name}_water_eq.data
