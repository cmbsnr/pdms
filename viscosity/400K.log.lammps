unfix               1
fix                 nvt all nvt temp ${T} ${T} 100.0
fix                 nvt all nvt temp 400 ${T} 100.0
fix                 nvt all nvt temp 400 400 100.0
timestep            1

## 4. Green–Kubo 粘度计算核心部分
variable            p equal 2000
variable            s equal 5
variable            d equal ${p}*${s}
variable            d equal 2000*${s}
variable            d equal 2000*5

thermo              $d
thermo              10000
thermo_style        custom step temp press

# 记录剪切应力张量
variable            pxy equal pxy
variable            pxz equal pxz
variable            pyz equal pyz

fix                 SS all ave/correlate ${s} ${p} ${d} v_pxy v_pxz v_pyz type auto file profile.gk ave running
fix                 SS all ave/correlate 5 ${p} ${d} v_pxy v_pxz v_pyz type auto file profile.gk ave running
fix                 SS all ave/correlate 5 2000 ${d} v_pxy v_pxz v_pyz type auto file profile.gk ave running
fix                 SS all ave/correlate 5 2000 10000 v_pxy v_pxz v_pyz type auto file profile.gk ave running

## 5. 粘度计算（单位转换）
variable            dt equal 10.0    # fs
variable            kB equal 1.38064852e-23
variable            vol equal vol    # 系统体积

# 单位换算
variable            atm2pa equal 1.01325e5
variable            fs2s equal 1.0e-15
variable            A2m equal 1.0e-10
variable            convert_eta equal ${atm2pa}*${atm2pa}*${A2m}*${A2m}*${A2m}*${fs2s}
variable            convert_eta equal 101325*${atm2pa}*${A2m}*${A2m}*${A2m}*${fs2s}
variable            convert_eta equal 101325*101325*${A2m}*${A2m}*${A2m}*${fs2s}
variable            convert_eta equal 101325*101325*1e-10*${A2m}*${A2m}*${fs2s}
variable            convert_eta equal 101325*101325*1e-10*1e-10*${A2m}*${fs2s}
variable            convert_eta equal 101325*101325*1e-10*1e-10*1e-10*${fs2s}
variable            convert_eta equal 101325*101325*1e-10*1e-10*1e-10*1e-15

# 粘度计算（Pa·s）
variable            scale equal 1.0/${T}/${kB}*vol*${s}*${dt}
variable            scale equal 1.0/400/${kB}*vol*${s}*${dt}
variable            scale equal 1.0/400/1.38064852e-23*vol*${s}*${dt}
variable            scale equal 1.0/400/1.38064852e-23*vol*5*${dt}
variable            scale equal 1.0/400/1.38064852e-23*vol*5*10
variable            vxy equal trap(f_SS[3])*${scale}*${convert_eta}
variable            vxy equal trap(f_SS[3])*1.35789478257811e+27*${convert_eta}
variable            vxy equal trap(f_SS[3])*1.35789478257811e+27*1.0266755625e-35
variable            vxz equal trap(f_SS[4])*${scale}*${convert_eta}
variable            vxz equal trap(f_SS[4])*1.35789478257811e+27*${convert_eta}
variable            vxz equal trap(f_SS[4])*1.35789478257811e+27*1.0266755625e-35
variable            vyz equal trap(f_SS[5])*${scale}*${convert_eta}
variable            vyz equal trap(f_SS[5])*1.35789478257811e+27*${convert_eta}
variable            vyz equal trap(f_SS[5])*1.35789478257811e+27*1.0266755625e-35
variable            final_viscosity equal (v_vxy+v_vxz+v_vyz)/3



## 6. 运行模拟并输出粘度
thermo_style        custom step temp press v_vxy v_vxz v_vyz v_final_viscosity
run                 5000000
