## 3. 温度与体系初始化
# velocity            all create 400.0 12345 mom yes rot yes dist gaussian
variable            T equal 400.0
fix                 1 all npt temp ${T} ${T} 100.0 iso 1.0 1.0 1000
fix                 1 all npt temp 400 ${T} 100.0 iso 1.0 1.0 1000
fix                 1 all npt temp 400 400 100.0 iso 1.0 1.0 1000
timestep            1
thermo_style        custom step temp press density vol
thermo              10000
run                 500000

