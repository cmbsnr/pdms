## 1. 基础设置
units               real
dimension           3
boundary            p p p
atom_style          full 

## 2. 读取 PDMS Martini 数据结构
pair_style lj/cut   12.0
special_bonds       lj 0.0 0.0 0.5

bond_style          harmonic
angle_style         harmonic
dihedral_style      harmonic
read_data           pdms_viscosity.data

## 3. 温度与体系初始化
# velocity            all create 400.0 12345 mom yes rot yes dist gaussian
variable            T equal 500.0
fix                 1 all npt temp ${T} ${T} 100.0 iso 1.0 1.0 1000
timestep            1
thermo_style        custom step temp press density vol
thermo              10000     
run                 500000
unfix               1
fix                 nvt all nvt temp ${T} ${T} 100.0
timestep            1

## 4. Green–Kubo 粘度计算核心部分
variable            p equal 2000
variable            s equal 5
variable            d equal ${p}*${s}

thermo              $d
thermo_style        custom step temp press

# 记录剪切应力张量
variable            pxy equal pxy
variable            pxz equal pxz
variable            pyz equal pyz

fix                 SS all ave/correlate ${s} ${p} ${d} v_pxy v_pxz v_pyz type auto file profile.gk ave running

## 5. 粘度计算（单位转换）
variable            dt equal 10.0    # fs
variable            kB equal 1.38064852e-23
variable            vol equal vol    # 系统体积

# 单位换算
variable            atm2pa equal 1.01325e5
variable            fs2s equal 1.0e-15
variable            A2m equal 1.0e-10
variable            convert_eta equal ${atm2pa}*${atm2pa}*${A2m}*${A2m}*${A2m}*${fs2s}

# 粘度计算（Pa·s）
variable            scale equal 1.0/${T}/${kB}*vol*${s}*${dt}
variable            vxy equal trap(f_SS[3])*${scale}*${convert_eta}
variable            vxz equal trap(f_SS[4])*${scale}*${convert_eta}
variable            vyz equal trap(f_SS[5])*${scale}*${convert_eta}
variable            final_viscosity equal (v_vxy+v_vxz+v_vyz)/3



## 6. 运行模拟并输出粘度
thermo_style        custom step temp press v_vxy v_vxz v_vyz v_final_viscosity
run                 5000000
