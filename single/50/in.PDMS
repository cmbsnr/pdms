# LAMMPS输入文件示例：使用Martini 3粗粒化力场计算PDMS的均方回转半径
# -----------------------------------------------------
# 1. 初始化设置
# -----------------------------------------------------
units               real
dimension           3
boundary            s s s
atom_style          full

# 读取包含PDMS分子结构的data文件
read_data           bad_pdms_s50.data

# -----------------------------------------------------
# 2. 力场参数设置（Martini 3参数）
# -----------------------------------------------------
# 定义非键相互作用（示例：Lennard-Jones势，截断距离可参考Martini 3常用取值）
pair_style lj/cut   7
special_bonds       lj 0.0 0.0 0.5
pair_coeff          1 1 0.7337 5.1
# 定义键、角、二面角势（示例参数，实际参数请参考相关文献）
bond_style          harmonic
bond_coeff          1 13.243 4.48
angle_style         harmonic
angle_coeff         1 5.48 86.0
dihedral_style      harmonic
dihedral_coeff      1 0.3346  1  1

# -----------------------------------------------------
# 3. 邻域列表设置
# -----------------------------------------------------
neigh_modify    one 1000
neighbor        1 bin
neigh_modify    delay 0 every 1 check yes

# -----------------------------------------------------
# 4. 能量最小化与预平衡
# -----------------------------------------------------
velocity        all create 300 4928459
minimize        1.0e-4 1.0e-6 1000 10000
dump            1 all custom 10000 dump.pdms_min.lammpstrj id type x y z vx vy vz
fix             1 all nvt temp 300 300 10
thermo_style    custom step temp press density vol
thermo          10000     
run             500000
unfix           1
write_data      pdms_50.data