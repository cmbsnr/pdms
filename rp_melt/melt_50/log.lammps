unfix           1

# variable        lambda equal ramp(0.8,1.0)
# fix             2 all adapt 1 pair lj/cut/soft lambda * * v_lambda

# fix             3 all npt temp 300.0 300.0 100.0 iso 1.0 1.0 1000
# timestep        1
# thermo_style    custom step temp press density vol
# thermo          10000
# run             50000
# unfix           3

# -----------------------------------------------------
# 5. 计算均方回转半径
# -----------------------------------------------------
# 使用compute gyration命令计算整个体系的回转半径
fix             equil all npt temp 300.0 300.0 100.0 iso 1.0 1.0 1000
group           pdms1 id <= 50
50 atoms in group pdms1
group           pdms2 id 51:100
50 atoms in group pdms2
group           pdms3 id 101:150
50 atoms in group pdms3
group           pdms4 id 151:200
50 atoms in group pdms4
group           pdms5 id 201:250
50 atoms in group pdms5
group           pdms6 id 251:300
50 atoms in group pdms6
group           pdms7 id 301:350
50 atoms in group pdms7
group           pdms8 id 351:400
50 atoms in group pdms8
group           pdms9 id 401:450
50 atoms in group pdms9
group           pdms10 id 451:500
50 atoms in group pdms10
# variable        d_end equal "sqrt((x[1]-x[10])^2 + (y[1]-y[10])^2 + (z[1]-z[10])^2)"
compute         rg1 pdms1 gyration
compute         rg2 pdms2 gyration
compute         rg3 pdms3 gyration
compute         rg4 pdms4 gyration
compute         rg5 pdms5 gyration
compute         rg6 pdms6 gyration
compute         rg7 pdms7 gyration
compute         rg8 pdms8 gyration
compute         rg9 pdms9 gyration
compute         rg10 pdms10 gyration
# fix             avg pdms ave/time 1000 800 1000000 c_rg v_d_end file avg.txt
# 输出热力学信息及回转半径数据，每隔1000步输出一次

compute 1 all msd com yes
variable msdx equal c_1[1]
variable msdy equal c_1[2]
variable msdz equal c_1[3]
variable msd equal  c_1[4]
variable istep equal step
fix 2 all print 1 "${istep} ${msdx} ${msdy} ${msdz} ${msd}" screen no file msd.dat
# 输出热力学信息及回转半径数据，每隔1000步输出一次
thermo_style    custom step temp pe ke etotal c_rg1 c_rg2 c_rg3 c_rg4 c_rg5 c_rg6 c_rg7 c_rg8 c_rg9 c_rg10 press density vol
thermo          10000
# 输出轨迹文件，便于后续可视化与分析
dump            traj all custom 1000 dump.pdms.lammpstrj id type x y z
# 运行模拟，记录回转半径数据（后续可统计分析均值与波动）
run             1000000
