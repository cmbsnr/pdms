units           metal
dimension       3
boundary        p p f
atom_style      full
log             log.indentation
# ---------- 金刚石晶格 ----------
lattice         diamond 3.567
region          whole block 0 200 0 200 0 200 units box
create_box      1 whole

# ---------- 板 ----------
region          board block 2.0 198.0 2.0 198.0 5.0 10.0 units box

# ---------- 填充原子 ----------
create_atoms    1 region board



pair_style      tersoff
pair_coeff      * * SiC.tersoff C
mass            1 12.011
write_data      board_ini.data
neighbor        0.1 bin
neigh_modify    every 1 delay 0 check yes
thermo          100
thermo_style    custom step atoms temp pe ke etotal density vol lx ly lz

fix                 zwallslo all wall/reflect zlo EDGE
fix                 zwallshi all wall/reflect zhi EDGE
dump            1 all atom 100 dump.board.lammpstrj
# minimize        1e-6 1e-8 1000 10000
# velocity        all create 300.0 4928459
fix             1 all nvt temp 300.0 300.0 10.0 # iso 1.0 1.0 1000.0
run             100000
write_data      board_final.data