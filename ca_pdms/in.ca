units               metal
dimension           3
boundary            p p f
atom_style          full
log                 log.ca_pdms
timestep            0.001

# 参数设置
variable            k equal "v_aint * 0.7337 / 23.06"  #定义压头与PDMS之间的LJ势的ε参数，单位为ev
read_data           ca_pdms.data
# 定义键、角、二面角势
bond_style          harmonic
bond_coeff          1 0.5743 4.48
angle_style         harmonic
angle_coeff         1 0.23764 86.0
dihedral_style      harmonic
dihedral_coeff      1 0.01451 1 1


pair_style          hybrid tersoff lj/cut 12.0
pair_coeff          * * tersoff SiC.tersoff NULL C
special_bonds       lj 0.0 0.0 0.5
pair_coeff          1 1 lj/cut 0.0318 5.1
pair_coeff          1 2 lj/cut ${k} 5.1
change_box          all z delta 0.0 10.0 units box

neighbor            0.2 bin
neigh_modify        delay 0 every 1 check yes
group               pdms type 1
group               bottom type 2
fix                 spring_bottom bottom spring/self 1.0
fix                 zwallslo all wall/reflect zlo EDGE
fix                 zwallshi all wall/reflect zhi EDGE
dump                1 all custom 1000 dump.ca_pdms_${aint}.lammpstrj id type x y z vx vy vz fx fy fz

fix                 3 pdms nvt temp 300.0 300.0 0.1
thermo_style        custom step atoms temp pe ke etotal density vol lx ly lz
thermo              1000
run                 200000
write_data          ca_pdms_${aint}_final.data