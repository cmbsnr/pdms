LAMMPS (29 Aug 2024)
# LAMMPS输入文件示例：使用Martini 3粗粒化力场计算PDMS的均方回转半径
# -----------------------------------------------------
# 1. 初始化设置
# -----------------------------------------------------
units               real
dimension           3
boundary            p p p
atom_style          full

# 读取包含PDMS分子结构的data文件
read_data           bad_pdms_100_box.data
Reading data file ...
  orthogonal box = (-1.9905 -2.134501 -2.405997) to (241.4995 241.3355 241.104)
